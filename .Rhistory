library(ggplot2)
# We simulate homoscedastic data
set.seed(123)
x_homoscedastic <- seq(1, 100, by = 1)
y_homoscedastic <- 5 + 0.5 * x_homoscedastic + rnorm(100, mean = 0, sd = 10)
# We simulate heteroscedastic data
