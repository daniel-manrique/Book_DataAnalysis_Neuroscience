/.quarto/
_book/
.Rproj.user
/env/
/references/books/
/.Renviron
/*.html
/*_files/

# LaTeX/PDF render leftovers. Rendering a single chapter to PDF (or keep-tex)
# drops these in the project root; the book itself builds into _book/.
# Anchored to the root so cached figures under _freeze/ are not affected.
/*.aux
/*.log
/*.toc
/*.lof
/*.lot
/*.out
/*.tex
/*.pdf
/*.bbl
/*.blg
/*.fls
/*.fdb_latexmk
/*.synctex.gz
/*.nav
/*.snm
/*.vrb

# Quarto leaves this behind when a render is interrupted or a file is locked
/site_libs/

# Intermediate file Quarto/knitr leaves when a render fails
/*.knit.md

# knitr intermediate left in the project root by a direct knit or a failed render
/*.rmarkdown

# Cached brms fits live outside git (large; Daniel stores them elsewhere)
models/*.rds

# Archives prepared for Zenodo by scripts/models-pack.R (upload them, do not commit)
/models-archive/

# Local R session files
.RData
.Rhistory

# Editor settings
.vscode/
